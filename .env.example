# Database Configuration
# Render and Railway should provide these through environment variables.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/itaccessdb
SPRING_DATASOURCE_DRIVER_CLASS=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# Hibernate Dialect
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# H2 Console (disable in production)
H2_CONSOLE_ENABLED=false

# Server Configuration
# Railway also exposes PORT; application.yml supports both SERVER_PORT and PORT.
SERVER_PORT=8000

# CORS Configuration
# In Railway, include the exact Railway URL plus your frontend URLs.
CORS_ALLOWED_ORIGINS=https://your-frontend-url.com,https://your-railway-preview-url.up.railway.app

# JWT Secret (REQUIRED in production - generate a secure random key)
# Keep the same value as Render if you want existing JWT tokens to remain valid.
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@itaccess.local

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# Upload directories
# Railway volumes should be mounted on /tmp/uploads
UPLOAD_DIR=/tmp/uploads/apk
ATTACHMENTS_DIR=/tmp/uploads/attachments
DOCUMENT_ARCHIVE_DIR=/tmp/uploads/documents
MAX_FILE_SIZE=150MB

# Backblaze B2 Storage (for Document Archive)
# Set B2_ENABLED=true to activate. Requires a Backblaze B2 bucket + Application Key.
B2_ENABLED=false
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET=taccess-storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_DOCUMENTS_PREFIX=document-archive/

# Logging Level
LOG_LEVEL=INFO
