# Railway Environment Variables for IT Access Manager
# Copy relevant values to Railway dashboard (Settings → Variables)

# Database (Railway PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<RAILWAY_POSTGRES_HOST>:5432/itaccessdb
SPRING_DATASOURCE_DRIVER_CLASS=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=<RAILWAY_POSTGRES_USER>
SPRING_DATASOURCE_PASSWORD=<RAILWAY_POSTGRES_PASSWORD>

# JWT Secret (same as Render to keep tokens valid)
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long

# Server
SERVER_PORT=8000

# CORS (include Railway URL and frontend URLs)
CORS_ALLOWED_ORIGINS=https://it-testerkansa.vercel.app,https://it-testerkansa-omega.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://itaccess-backend-production-5145.up.railway.app

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@itaccess.local

# Frontend URL
FRONTEND_URL=https://it-testerkansa-omega.vercel.app

# Upload directories (use /tmp for Railway, mount volume on /tmp/uploads)
UPLOAD_DIR=/tmp/uploads/apk
ATTACHMENTS_DIR=/tmp/uploads/attachments
DOCUMENT_ARCHIVE_DIR=/tmp/uploads/documents
MAX_FILE_SIZE=150MB

# Backblaze B2 Storage (for Document Archive)
# Enable only after creating the bucket and generating Application Key in Backblaze dashboard.
B2_ENABLED=true
B2_KEY_ID=a5352921f096
B2_APPLICATION_KEY=<SECRET_c29b0a2e>c29b0a2e
B2_BUCKET=itaccess-storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_DOCUMENTS_PREFIX=document-archive/
