# Railway environment variables for the Spring Boot backend.
# Add these in Railway > Variables. Do not commit real secrets.

SPRING_DATASOURCE_URL=jdbc:postgresql://itaccess-db.railway.internal:5432/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<railway-postgres-password>

SERVER_PORT=8000
JWT_SECRET=<same-secret-as-render-if-you-want-existing-tokens-to-stay-valid>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
MAIL_FROM=noreply@itaccess.local

CORS_ALLOWED_ORIGINS=https://your-frontend-url.com,https://your-railway-preview-url.up.railway.app
FRONTEND_URL=https://your-frontend-url.com

UPLOAD_DIR=/app/uploads/apk
ATTACHMENTS_DIR=/app/uploads/attachments
MAX_FILE_SIZE=150MB

LOG_LEVEL=INFO
